<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    
    
    <PublishAot>true</PublishAot>
    <IsTrimmable>true</IsTrimmable>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <CompressionLevel>SmallestSize</CompressionLevel>

    <StripSymbols>true</StripSymbols>
    <IlcOptimizationPreference>Size</IlcOptimizationPreference>
    <IlcInvariantGlobalization>true</IlcInvariantGlobalization>
    <IlcDisableExceptionMessages>true</IlcDisableExceptionMessages>

    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <IlcGenerateStackTraceData>false</IlcGenerateStackTraceData>
    <IlcDisableReflection>true</IlcDisableReflection>
    <EventSourceSupport>false</EventSourceSupport>
    <IlcTrimComInterop>false</IlcTrimComInterop>
    <DebuggerSupport>false</DebuggerSupport>

    <IlcOptimizationPreference>Size</IlcOptimizationPreference>
    <IlcDisableRuntimeMarshalling>true</IlcDisableRuntimeMarshalling>

    <CompilerGeneratedFilesOutputPath>obj/Generated</CompilerGeneratedFilesOutputPath>

    <RootNamespace>Neemle.XJson.Sample</RootNamespace>

    <AssemblyName>xjson_sample_app</AssemblyName>

    <IsPackable>false</IsPackable>

    <Company>Neemle</Company>

    <Product>XJson</Product>

    <AssemblyVersion>1.0.0.0</AssemblyVersion>

    <FileVersion>1.0.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Abstractions\Abstractions.csproj" />
    <ProjectReference Include="..\XJson.Generator\XJson.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
